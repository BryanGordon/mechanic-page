---
import Logo from './Logo.astro';
import { navLinks, site } from '../data/site';

const year = new Date().getFullYear();
const telHref = (phone: string) => `tel:${phone.replace(/[^\d+]/g, '')}`;
---

<footer class="footer" data-footer>
  <div class="footer__inner">
    <div class="footer__brand">
      <Logo compact />
      <p class="footer__tagline">
        Diagnóstico, mantenimiento y reparación con estándares de taller de competición.
      </p>
    </div>

    <nav class="footer__col" aria-label="Navegación del pie de página">
      <h2 class="footer__title">Navegación</h2>
      <ul class="footer__list">
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer__col">
      <h2 class="footer__title">Contacto</h2>
      <ul class="footer__list">
        <li><a href={telHref(site.phones[0])}>{site.phones[0]}</a></li>
        <li><span class="footer__email">{site.email}</span></li>
        <li><span class="footer__muted">{site.hours}</span></li>
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <p>© {year} {site.name}. Todos los derechos reservados.</p>
    <p class="footer__muted">Diseñado para durar tantos kilómetros como tu motor.</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 10;
    background: var(--c-bg);
    padding-inline: var(--gutter);
    border-top: 1px solid rgba(255, 207, 229, 0.12);
  }

  /* Neon light source: a soft bloom sitting on the bottom edge */
  .footer::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px 0;
    height: 4px;
    background: var(--c-neon);
    filter: blur(5px);
    opacity: 0.9;
    pointer-events: none;
  }

  /* Neon light diffusing inward across the footer */
  .footer::before {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 140px;
    background: linear-gradient(
      to top,
      rgba(255, 207, 229, 0.5) 0%,
      rgba(255, 207, 229, 0.26) 12%,
      rgba(255, 207, 229, 0.13) 28%,
      rgba(255, 207, 229, 0.05) 48%,
      rgba(255, 207, 229, 0.015) 68%,
      rgba(255, 207, 229, 0) 88%
    );
    filter: blur(12px);
    pointer-events: none;
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 60px;
    padding-block: 72px 56px;
  }

  .footer__brand {
    display: grid;
    align-content: start;
    gap: 20px;
    max-width: 360px;
  }

  .footer__tagline {
    font-size: 0.92rem;
    opacity: 0.68;
  }

  .footer__title {
    margin-bottom: 20px;
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--c-neon);
  }

  .footer__list {
    display: grid;
    gap: 12px;
    font-size: 0.92rem;
  }

  .footer__list a,
  .footer__email {
    opacity: 0.72;
    transition: opacity 0.25s ease, transform 0.25s ease;
    display: inline-block;
  }

  .footer__list a:hover,
  .footer__email:hover {
    opacity: 1;
    transform: translateX(4px);
  }

  .footer__muted {
    opacity: 0.5;
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    /* Extra bottom padding keeps the small print out of the neon bloom */
    padding: 26px 0 64px;
    border-top: 1px solid rgba(255, 207, 229, 0.12);
    font-size: 0.8rem;
    opacity: 0.85;
    /* Keeps the small print readable over the neon bloom */
    text-shadow: 0 1px 10px rgba(42, 15, 26, 0.45);
  }
</style>
