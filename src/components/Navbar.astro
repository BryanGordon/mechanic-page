---
import Logo from './Logo.astro';
import { navLinks } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="navbar" data-navbar>
  <div class="navbar__inner">
    <Logo />

    <nav class="navbar__nav" aria-label="Navegación principal">
      {navLinks.map((link) => (
        <a
          class:list={['nav-link', { 'is-active': isActive(link.href) }]}
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: relative;
    z-index: 20;
    background: var(--c-bg);
  }

  /* Neon light source: a soft bloom sitting on the top edge */
  .navbar::after {
    content: '';
    position: absolute;
    inset: -1px 0 auto 0;
    height: 4px;
    background: var(--c-neon);
    filter: blur(5px);
    opacity: 0.9;
    pointer-events: none;
  }

  /* Neon light diffusing inward across the navbar */
  .navbar::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 140px;
    background: linear-gradient(
      to bottom,
      rgba(255, 207, 229, 0.5) 0%,
      rgba(255, 207, 229, 0.26) 12%,
      rgba(255, 207, 229, 0.13) 28%,
      rgba(255, 207, 229, 0.05) 48%,
      rgba(255, 207, 229, 0.015) 68%,
      rgba(255, 207, 229, 0) 88%
    );
    filter: blur(12px);
    pointer-events: none;
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    gap: 48px;
    height: var(--nav-h);
    padding-inline: var(--gutter);
    /* Test: content pushed down so the neon bloom does not wash over it */
    transform: translateY(10px);
  }

  .navbar__nav {
    flex: 1;
    display: flex;
    align-items: stretch;
    justify-content: space-around;
    height: 100%;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding-inline: 6px;
    font-family: var(--font-display);
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.72;
    transition: opacity 0.25s ease, color 0.25s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: 26px;
    height: 2px;
    background: var(--c-neon);
    box-shadow: 0 0 10px rgba(255, 207, 229, 0.7);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-link:hover,
  .nav-link.is-active {
    opacity: 1;
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }
</style>
